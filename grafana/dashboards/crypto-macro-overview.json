          "queryText": "WITH monthly_values AS (\n    SELECT\n        symbol,\n        value,\n        observed_at,\n        date(substr(observed_at, 1, 10)) AS observed_date\n    FROM macro_series\n    WHERE source = 'fred'\n      AND symbol IN ('CPI', 'CORE_CPI', 'PCE', 'CORE_PCE')\n),\nyoy_values AS (\n    SELECT\n        current.symbol,\n        current.observed_at AS time,\n        current.observed_date,\n        ((current.value / previous.value) - 1.0) * 100.0 AS yoy_percent\n    FROM monthly_values current\n    JOIN monthly_values previous\n      ON previous.symbol = current.symbol\n     AND previous.observed_date = date(current.observed_date, '-1 year')\n)\nSELECT\n    time,\n    MAX(CASE WHEN symbol = 'CPI' THEN yoy_percent END) AS \"CPI YoY\",\n    MAX(CASE WHEN symbol = 'CORE_CPI' THEN yoy_percent END) AS \"Core CPI YoY\",\n    MAX(CASE WHEN symbol = 'PCE' THEN yoy_percent END) AS \"PCE YoY\",\n    MAX(CASE WHEN symbol = 'CORE_PCE' THEN yoy_percent END) AS \"Core PCE YoY\"\nFROM yoy_values\nGROUP BY time\nORDER BY time ASC   ",
          "queryType": "table",
          "rawQueryText": "WITH monthly_values AS (\n    SELECT\n        symbol,\n        value,\n        observed_at,\n        date(substr(observed_at, 1, 10)) AS observed_date\n    FROM macro_series\n    WHERE source = 'fred'\n      AND symbol IN ('CPI', 'CORE_CPI', 'PCE', 'CORE_PCE')\n),\nyoy_values AS (\n    SELECT\n        current.symbol,\n        current.observed_at AS time,\n        current.observed_date,\n        ((current.value / previous.value) - 1.0) * 100.0 AS yoy_percent\n    FROM monthly_values current\n    JOIN monthly_values previous\n      ON previous.symbol = current.symbol\n     AND previous.observed_date = date(current.observed_date, '-1 year')\n)\nSELECT\n    time,\n    MAX(CASE WHEN symbol = 'CPI' THEN yoy_percent END) AS \"CPI YoY\",\n    MAX(CASE WHEN symbol = 'CORE_CPI' THEN yoy_percent END) AS \"Core CPI YoY\",\n    MAX(CASE WHEN symbol = 'PCE' THEN yoy_percent END) AS \"PCE YoY\",\n    MAX(CASE WHEN symbol = 'CORE_PCE' THEN yoy_percent END) AS \"Core PCE YoY\"\nFROM yoy_values\nGROUP BY time\nORDER BY time ASC   ",
          "refId": "A",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
