          "queryText": "WITH monthly_values AS (\n    SELECT\n        symbol,\n        value,\n        date(substr(observed_at, 1, 10)) AS observed_date\n    FROM macro_series\n    WHERE source = 'fred'\n      AND symbol IN ('CPI', 'CORE_CPI', 'PCE', 'CORE_PCE')\n),\nyoy_values AS (\n    SELECT\n        current.symbol,\n        current.observed_date,\n        ((current.value / previous.value) - 1.0) * 100.0 AS yoy_percent\n    FROM monthly_values current\n    JOIN monthly_values previous\n      ON previous.symbol = current.symbol\n     AND previous.observed_date = date(current.observed_date, '-1 year')\n),\nlatest_dates AS (\n    SELECT\n        symbol,\n        MAX(observed_date) AS latest_observed_date\n    FROM yoy_values\n    GROUP BY symbol\n)\nSELECT\n    MAX(CASE WHEN y.symbol = 'CPI' THEN y.yoy_percent END) AS \"CPI YoY\",\n    MAX(CASE WHEN y.symbol = 'CORE_CPI' THEN y.yoy_percent END) AS \"Core CPI YoY\",\n    MAX(CASE WHEN y.symbol = 'PCE' THEN y.yoy_percent END) AS \"PCE YoY\",\n    MAX(CASE WHEN y.symbol = 'CORE_PCE' THEN y.yoy_percent END) AS \"Core PCE YoY\"\nFROM yoy_values y\nJOIN latest_dates latest\n  ON latest.symbol = y.symbol\n AND latest.latest_observed_date = y.observed_date",
          "queryType": "table",
          "rawQueryText": "WITH monthly_values AS (\n    SELECT\n        symbol,\n        value,\n        date(substr(observed_at, 1, 10)) AS observed_date\n    FROM macro_series\n    WHERE source = 'fred'\n      AND symbol IN ('CPI', 'CORE_CPI', 'PCE', 'CORE_PCE')\n),\nyoy_values AS (\n    SELECT\n        current.symbol,\n        current.observed_date,\n        ((current.value / previous.value) - 1.0) * 100.0 AS yoy_percent\n    FROM monthly_values current\n    JOIN monthly_values previous\n      ON previous.symbol = current.symbol\n     AND previous.observed_date = date(current.observed_date, '-1 year')\n),\nlatest_dates AS (\n    SELECT\n        symbol,\n        MAX(observed_date) AS latest_observed_date\n    FROM yoy_values\n    GROUP BY symbol\n)\nSELECT\n    MAX(CASE WHEN y.symbol = 'CPI' THEN y.yoy_percent END) AS \"CPI YoY\",\n    MAX(CASE WHEN y.symbol = 'CORE_CPI' THEN y.yoy_percent END) AS \"Core CPI YoY\",\n    MAX(CASE WHEN y.symbol = 'PCE' THEN y.yoy_percent END) AS \"PCE YoY\",\n    MAX(CASE WHEN y.symbol = 'CORE_PCE' THEN y.yoy_percent END) AS \"Core PCE YoY\"\nFROM yoy_values y\nJOIN latest_dates latest\n  ON latest.symbol = y.symbol\n AND latest.latest_observed_date = y.observed_date",
