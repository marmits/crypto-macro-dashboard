              "queryText": "WITH latest_observations AS (\n    SELECT\n        symbol,\n        MAX(observed_at) AS latest_observed_at\n    FROM macro_series\n    WHERE source = 'fred'\n      AND symbol IN ('US2Y', 'US10Y', 'US30Y')\n    GROUP BY symbol\n)\nSELECT\n    MAX(CASE WHEN m.symbol = 'US2Y' THEN m.value END) AS US2Y,\n    MAX(CASE WHEN m.symbol = 'US10Y' THEN m.value END) AS US10Y,\n    MAX(CASE WHEN m.symbol = 'US30Y' THEN m.value END) AS US30Y\nFROM macro_series m\nJOIN latest_observations latest\n  ON latest.symbol = m.symbol\n AND latest.latest_observed_at = m.observed_at\nWHERE m.source = 'fred'\n  AND m.symbol IN ('US2Y', 'US10Y', 'US30Y')",
              "queryType": "table",
              "rawQueryText": "WITH latest_observations AS (\n    SELECT\n        symbol,\n        MAX(observed_at) AS latest_observed_at\n    FROM macro_series\n    WHERE source = 'fred'\n      AND symbol IN ('US2Y', 'US10Y', 'US30Y')\n    GROUP BY symbol\n)\nSELECT\n    MAX(CASE WHEN m.symbol = 'US2Y' THEN m.value END) AS US2Y,\n    MAX(CASE WHEN m.symbol = 'US10Y' THEN m.value END) AS US10Y,\n    MAX(CASE WHEN m.symbol = 'US30Y' THEN m.value END) AS US30Y\nFROM macro_series m\nJOIN latest_observations latest\n  ON latest.symbol = m.symbol\n AND latest.latest_observed_at = m.observed_at\nWHERE m.source = 'fred'\n  AND m.symbol IN ('US2Y', 'US10Y', 'US30Y')",
              "refId": "A",
              "timeColumns": [
